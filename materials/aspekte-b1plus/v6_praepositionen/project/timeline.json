   "end": 4.579
  },
  {
   "block": 0,
   "role": "seg",
   "k": 2,
   "text": "Warum auf? Und warum von?",
   "start": 5.479,
   "end": 7.569
  },
  {
   "block": 0,
   "role": "seg",
   "k": 3,
   "text": "Diese Präpositionen gehören fest zum Verb.",
   "start": 8.469,
   "end": 11.347
  },
  {
   "block": 0,
   "role": "seg",
   "k": 4,
   "text": "Man lernt sie am besten zusammen.",
   "start": 12.247,
   "end": 14.36
  },
  {
   "block": 1,
   "role": "seg",
   "k": 0,
   "text": "Regel eins.",
   "start": 16.36,
   "end": 17.595
  },
  {
   "block": 1,
   "role": "seg",
   "k": 1,
   "text": "Nach auf, über, für und an steht hier meistens der Akkusativ.",
   "start": 18.495,
   "end": 22.483
  },
  {
   "block": 1,
   "role": "seg",
   "k": 2,
   "text": "Ich warte auf den Bus.",
   "start": 23.383,
   "end": 24.741
  },
  {
   "block": 1,
   "role": "seg",
   "k": 3,
   "text": "Wir freuen uns auf das Wochenende.",
   "start": 25.641,
   "end": 27.522
  },
  {
   "block": 1,
   "role": "seg",
   "k": 4,
   "text": "Sie interessiert sich für moderne Kunst.",
   "start": 28.422,
   "end": 30.5
  },
  {
   "block": 1,
   "role": "seg",
   "k": 5,
   "text": "Er ärgert sich über den Lärm.",
   "start": 31.4,
   "end": 33.057
  },
  {
   "block": 2,
   "role": "seg",
   "k": 0,
   "text": "Noch mehr Beispiele.",
   "start": 35.057,
   "end": 36.28
  },
  {
   "block": 2,
   "role": "seg",
   "k": 1,
   "text": "Ich denke oft an meine Familie.",
   "start": 37.18,
   "end": 39.13
  },
  {
   "block": 2,
   "role": "seg",
   "k": 2,
   "text": "Wir sprechen über das Wetter.",
   "start": 40.03,
   "end": 41.566
  },
  {
   "block": 2,
   "role": "seg",
   "k": 3,
   "text": "Ich bedanke mich für das Geschenk.",
   "start": 42.466,
   "end": 44.277
  },
  {
   "block": 2,
   "role": "seg",
   "k": 4,
   "text": "Er bittet um Hilfe.",
   "start": 45.177,
   "end": 46.431
  },
  {
   "block": 3,
   "role": "seg",
   "k": 0,
   "text": "Regel zwei.",
   "start": 48.431,
   "end": 49.413
  },
  {
   "block": 3,
   "role": "seg",
   "k": 1,
   "text": "Nach mit, von, zu, vor und nach steht der Dativ.",
   "start": 50.313,
   "end": 53.45
  },
  {
   "block": 3,
   "role": "seg",
   "k": 2,
   "text": "Ich spreche mit meinem Chef.",
   "start": 54.35,
   "end": 55.807
  },
  {
   "block": 3,
   "role": "seg",
   "k": 3,
   "text": "Er träumt von einem eigenen Haus.",
   "start": 56.707,
   "end": 58.797
  },
  {
   "block": 3,
   "role": "seg",
   "k": 4,
   "text": "Das Kind hat Angst vor dem Hund.",
   "start": 59.697,
   "end": 61.531
  },
  {
   "block": 3,
   "role": "seg",
   "k": 5,
   "text": "Sie fragt nach dem Weg.",
   "start": 62.431,
   "end": 64.01
  },
  {
   "block": 4,
   "role": "seg",
   "k": 0,
   "text": "Noch mehr Beispiele.",
   "start": 66.01,
   "end": 67.262
  },
  {
   "block": 4,
   "role": "seg",
   "k": 1,
   "text": "Ich treffe mich mit meinen Freunden.",
   "start": 68.162,
   "end": 69.904
  },
  {
   "block": 4,
   "role": "seg",
   "k": 2,
   "text": "Sie gratuliert ihm zum Geburtstag.",
   "start": 70.804,
   "end": 72.952
  },
  {
   "block": 4,
   "role": "seg",
   "k": 3,
   "text": "Wir nehmen am Kurs teil.",
   "start": 73.852,
   "end": 75.361
  },
  {
   "block": 4,
   "role": "seg",
   "k": 4,
   "text": "Er leidet unter dem Stress.",
   "start": 76.261,
   "end": 77.944
  },
  {
   "block": 4,
   "role": "seg",
   "k": 5,
   "text": "Achtung: teilnehmen an, mit Dativ!",
   "start": 78.844,
   "end": 81.13
  },
  {
   "block": 5,
   "role": "seg",
   "k": 0,
   "text": "Regel drei: die Fragen.",
   "start": 83.13,
   "end": 84.83
  },
  {
   "block": 5,
   "role": "seg",
   "k": 1,
   "text": "Bei Sachen fragt man mit wo plus Präposition.",
   "start": 85.73,
   "end": 88.83
  },
  {
   "block": 5,
   "role": "seg",
   "k": 2,
   "text": "Worauf wartest du? Auf den Bus.",
   "start": 89.73,
   "end": 91.808
  },
  {
   "block": 5,
   "role": "seg",
   "k": 3,
   "text": "Wovon träumst du? Vom Urlaub.",
   "start": 92.708,
   "end": 94.573
  },
  {
   "block": 5,
   "role": "seg",
   "k": 4,
   "text": "Woran denkst du? An die Prüfung.",
   "start": 95.473,
   "end": 97.66
  },
  {
   "block": 5,
   "role": "seg",
   "k": 5,
   "text": "Beginnt die Präposition mit einem Vokal, kommt ein r dazu.",
   "start": 98.56,
   "end": 102.43
  },
  {
   "block": 6,
   "role": "seg",
   "k": 0,
   "text": "Bei Personen fragt man anders: Präposition plus wen oder wem.",
   "start": 104.43,
   "end": 108.772
  },
  {
   "block": 6,
   "role": "seg",
   "k": 1,
   "text": "Auf wen wartest du? Auf meine Schwester.",
   "start": 109.672,
   "end": 111.995
  },
  {
   "block": 6,
   "role": "seg",
   "k": 2,
   "text": "Mit wem sprichst du? Mit meinem Chef.",
   "start": 112.895,
   "end": 115.074
  },
  {
   "block": 6,
   "role": "seg",
   "k": 3,
   "text": "An wen denkst du? An meine Oma.",
   "start": 115.974,
   "end": 117.863
  },
  {
   "block": 7,
   "role": "seg",
   "k": 0,
   "text": "Regel vier.",
   "start": 119.863,
   "end": 120.728
  },
  {
   "block": 7,
   "role": "seg",
   "k": 1,
   "text": "Statt einer Sache sagst du da plus Präposition.",
   "start": 121.628,
   "end": 124.728
  },
  {
   "block": 7,
   "role": "seg",
   "k": 2,
   "text": "Freust du dich auf den Urlaub? Ja, ich freue mich darauf.",
   "start": 125.628,
   "end": 128.527
  },
  {
   "block": 7,
   "role": "seg",
   "k": 3,
   "text": "Hast du Angst vor der Prüfung? Nein, davor habe ich keine Angst.",
   "start": 129.427,
   "end": 133.374
  },
  {
   "block": 7,
   "role": "seg",
   "k": 4,
   "text": "Aber bei Personen nimmst du ein Pronomen: Ich warte auf ihn.",
   "start": 134.274,
   "end": 137.518
  },
  {
   "block": 8,
   "role": "seg",
   "k": 0,
   "text": "Mein Tipp: Lerne immer das ganze Paket.",
   "start": 139.518,
   "end": 141.926
  },
  {
   "block": 8,
   "role": "seg",
   "k": 1,
   "text": "Warten auf, plus Akkusativ.",
   "start": 142.826,
   "end": 144.939
  },
  {
   "block": 8,
   "role": "seg",
   "k": 2,
   "text": "Träumen von, plus Dativ.",
