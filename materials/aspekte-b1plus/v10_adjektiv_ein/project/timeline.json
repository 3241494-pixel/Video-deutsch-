{
 "duration": 271.9,
 "segs": [
  {
   "block": 0,
   "role": "seg",
   "k": 0,
   "text": "Der neue Film. Aber: ein neuer Film.",
   "start": 0.8,
   "end": 3.453
  },
  {
   "block": 0,
   "role": "seg",
   "k": 1,
   "text": "Warum plötzlich neuer?",
   "start": 4.353,
   "end": 5.839
  },
  {
   "block": 0,
   "role": "seg",
   "k": 2,
   "text": "Ein zeigt nicht, ob das Wort maskulin oder neutral ist.",
   "start": 6.739,
   "end": 10.605
  },
  {
   "block": 0,
   "role": "seg",
   "k": 3,
   "text": "Dann übernimmt das Adjektiv diese Aufgabe.",
   "start": 11.505,
   "end": 14.02
  },
  {
   "block": 1,
   "role": "seg",
   "k": 0,
   "text": "Regel eins: Nominativ nach ein.",
   "start": 16.02,
   "end": 18.477
  },
  {
   "block": 1,
   "role": "seg",
   "k": 1,
   "text": "Maskulin: ein neuer Film.",
   "start": 19.377,
   "end": 21.235
  },
  {
   "block": 1,
   "role": "seg",
   "k": 2,
   "text": "Neutral: ein neues Auto.",
   "start": 22.135,
   "end": 24.048
  },
  {
   "block": 1,
   "role": "seg",
   "k": 3,
   "text": "Feminin: eine neue Lampe.",
   "start": 24.948,
   "end": 26.592
  },
  {
   "block": 1,
   "role": "seg",
   "k": 4,
   "text": "Er, es, e. Wie bei der, das, die.",
   "start": 27.492,
   "end": 30.132
  },
  {
   "block": 2,
   "role": "seg",
   "k": 0,
   "text": "Im Akkusativ ändert sich nur maskulin.",
   "start": 32.132,
   "end": 34.965
  },
  {
   "block": 2,
   "role": "seg",
   "k": 1,
   "text": "Ich kaufe einen neuen Tisch.",
   "start": 35.865,
   "end": 37.746
  },
  {
   "block": 2,
   "role": "seg",
   "k": 2,
   "text": "Ich kaufe ein neues Sofa.",
   "start": 38.646,
   "end": 40.353
  },
  {
   "block": 2,
   "role": "seg",
   "k": 3,
   "text": "Ich kaufe eine neue Lampe.",
   "start": 41.253,
   "end": 42.823
  },
  {
   "block": 3,
   "role": "seg",
   "k": 0,
   "text": "Regel zwei: Im Dativ und Genitiv ist es wie immer.",
   "start": 44.823,
   "end": 48.435
  },
  {
   "block": 3,
   "role": "seg",
   "k": 1,
   "text": "Das Adjektiv bekommt e und n.",
   "start": 49.335,
   "end": 51.831
  },
  {
   "block": 3,
   "role": "seg",
   "k": 2,
   "text": "Mit einem neuen Freund.",
   "start": 52.731,
   "end": 54.048
  },
  {
   "block": 3,
   "role": "seg",
   "k": 3,
   "text": "In einer kleinen Wohnung.",
   "start": 54.948,
   "end": 56.469
  },
  {
   "block": 3,
   "role": "seg",
   "k": 4,
   "text": "Wegen eines langen Staus.",
   "start": 57.369,
   "end": 58.797
  },
  {
   "block": 4,
   "role": "seg",
   "k": 0,
   "text": "Genauso funktioniert es nach kein, mein, dein und so weiter.",
   "start": 60.797,
   "end": 64.266
  },
  {
   "block": 4,
   "role": "seg",
   "k": 1,
   "text": "Das ist mein bester Freund.",
   "start": 65.166,
   "end": 66.675
  },
  {
   "block": 4,
   "role": "seg",
   "k": 2,
   "text": "Ich habe keine große Lust.",
   "start": 67.575,
   "end": 68.945
  },
  {
   "block": 4,
   "role": "seg",
   "k": 3,
   "text": "Unser altes Auto ist kaputt.",
   "start": 69.845,
   "end": 71.946
  },
  {
   "block": 4,
   "role": "seg",
   "k": 4,
   "text": "Im Plural: keine neuen Ideen, meine alten Freunde.",
   "start": 72.846,
   "end": 76.287
  },
  {
   "block": 5,
   "role": "seg",
   "k": 0,
   "text": "Hier ist die Tabelle für ein.",
   "start": 78.287,
   "end": 80.046
  },
  {
   "block": 5,
   "role": "seg",
   "k": 1,
   "text": "Nominativ: ein neuer, ein neues, eine neue.",
   "start": 80.946,
   "end": 83.898
  },
  {
   "block": 5,
   "role": "seg",
   "k": 2,
   "text": "Akkusativ: einen neuen, ein neues, eine neue.",
   "start": 84.798,
   "end": 88.088
  },
  {
   "block": 5,
   "role": "seg",
   "k": 3,
   "text": "Dativ: einem neuen, einem neuen, einer neuen.",
   "start": 88.988,
   "end": 92.175
  },
  {
   "block": 5,
   "role": "seg",
   "k": 4,
   "text": "Genitiv: eines neuen, eines neuen, einer neuen.",
   "start": 93.075,
   "end": 96.485
  },
  {
   "block": 5,
   "role": "seg",
   "k": 5,
   "text": "Im Plural, zum Beispiel mit keine, immer e und n.",
   "start": 97.385,
   "end": 101.242
  },
  {
   "block": 6,
   "role": "seg",
   "k": 0,
   "text": "Regel drei: ohne Artikel.",
   "start": 103.242,
   "end": 104.881
  },
  {
   "block": 6,
   "role": "seg",
   "k": 1,
   "text": "Dann bekommt das Adjektiv die Endung vom Artikel.",
   "start": 105.781,
   "end": 108.853
  },
  {
   "block": 6,
   "role": "seg",
   "k": 2,
   "text": "Der Kaffee: heißer Kaffee.",
   "start": 109.753,
   "end": 111.505
  },
  {
   "block": 6,
   "role": "seg",
   "k": 3,
   "text": "Das Wasser: kaltes Wasser.",
   "start": 112.405,
   "end": 113.994
  },
  {
   "block": 6,
   "role": "seg",
   "k": 4,
   "text": "Die Milch: frische Milch.",
   "start": 114.894,
   "end": 116.357
  },
  {
   "block": 6,
   "role": "seg",
   "k": 5,
   "text": "Die Äpfel: rote Äpfel.",
   "start": 117.257,
   "end": 118.88
  },
  {
   "block": 7,
   "role": "seg",
   "k": 0,
   "text": "Auch im Dativ nimmt das Adjektiv die Endung vom Artikel.",
   "start": 120.88,
   "end": 124.572
  },
  {
   "block": 7,
   "role": "seg",
   "k": 1,
   "text": "Mit heißem Kaffee. Wie bei dem.",
   "start": 125.472,
   "end": 127.621
  },
  {
   "block": 7,
   "role": "seg",
   "k": 2,
   "text": "Mit kaltem Wasser.",
   "start": 128.521,
   "end": 129.845
  },
  {
   "block": 7,
   "role": "seg",
   "k": 3,
   "text": "Mit frischer Milch. Wie bei der.",
   "start": 130.745,
   "end": 132.631
  },
  {
   "block": 7,
   "role": "seg",
   "k": 4,
   "text": "Nach Zahlen und nach viele oder einige ist es genauso: zwei kleine Kinder, viele nette Leute.",
   "start": 133.531,
   "end": 139.179
  },
  {
   "block": 8,
   "role": "seg",
   "k": 0,
   "text": "Also, noch einmal alle drei Typen:",
   "start": 141.179,
   "end": 143.352
  },
  {
   "block": 8,
   "role": "seg",
   "k": 1,
   "text": "Der kalte Saft.",
   "start": 144.252,
   "end": 145.343
  },
  {
   "block": 8,
   "role": "seg",
   "k": 2,
   "text": "Ein kalter Saft.",
   "start": 146.243,
   "end": 147.532
  },
  {
   "block": 8,
   "role": "seg",
   "k": 3,
   "text": "Kalter Saft.",
   "start": 148.432,
   "end": 149.384
  },
  {
   "block": 8,
   "role": "seg",
   "k": 4,
   "text": "Die Information steht nur einmal: im Artikel oder im Adjektiv.",
   "start": 150.284,
   "end": 154.931
  },
  {
   "block": 9,
   "role": "intro",
   "k": 0,
   "text": "Und jetzt der Test!",
   "start": 156.931,
   "end": 158.092
  },
  {
   "block": 9,
   "role": "intro",
   "k": 1,
   "text": "Teil eins: Welche Endung kommt nach ein, kein und mein?",
   "start": 158.992,
   "end": 163.054
  },
  {
   "block": 9,
   "role": "q",
   "k": 2,
   "text": "Eins: klein. Ein … Hund.",
   "start": 163.954,
   "end": 166.853
  },
  {
   "block": 9,
   "role": "q",
   "k": 3,
   "text": "Zwei: groß. Ein … Haus.",
   "start": 167.753,
   "end": 170.626
  },
  {
   "block": 9,
   "role": "q",
   "k": 4,
   "text": "Drei: neu. Ich habe einen … Job.",
   "start": 171.526,
   "end": 174.604
  },
  {
   "block": 9,
   "role": "q",
   "k": 5,
   "text": "Vier: best. Das ist meine … Freundin.",
   "start": 175.504,
   "end": 179.111
  },
  {
   "block": 9,
   "role": "q",
   "k": 6,
   "text": "Fünf: alt. Mit einem … Freund.",
   "start": 180.011,
   "end": 183.18
  },
  {
   "block": 9,
   "role": "q",
   "k": 7,
   "text": "Sechs: eigen. Er hat kein … Zimmer.",
   "start": 184.08,
   "end": 187.524
  },
  {
   "block": 9,
   "role": "pause",
   "k": 8,
   "text": "Drück auf Pause und denk nach!",
   "start": 188.424,
   "end": 190.593
  },
  {
   "block": 9,
   "role": "a",
   "k": 9,
   "text": "Ein kleiner Hund.",
   "start": 199.293,
   "end": 200.373
  },
  {
   "block": 9,
   "role": "a",
   "k": 10,
   "text": "Ein großes Haus.",
   "start": 201.273,
   "end": 202.643
  },
  {
   "block": 9,
   "role": "a",
   "k": 11,
   "text": "Ich habe einen neuen Job.",
   "start": 203.543,
   "end": 205.11
  },
  {
   "block": 9,
   "role": "a",
   "k": 12,
   "text": "Das ist meine beste Freundin.",
   "start": 206.01,
   "end": 207.705
  },
  {
   "block": 9,
   "role": "a",
   "k": 13,
   "text": "Mit einem alten Freund.",
   "start": 208.605,
   "end": 209.935
  },
  {
   "block": 9,
   "role": "a",
   "k": 14,
   "text": "Er hat kein eigenes Zimmer.",
   "start": 210.835,
   "end": 212.449
  },
  {
   "block": 10,
   "role": "intro",
   "k": 0,
   "text": "Teil zwei: ohne Artikel!",
   "start": 214.449,
   "end": 216.457
  },
  {
   "block": 10,
   "role": "q",
   "k": 1,
   "text": "Eins: heiß. Ich trinke gern … Tee.",
   "start": 217.357,
   "end": 220.847
  },
  {
   "block": 10,
   "role": "q",
   "k": 2,
   "text": "Zwei: frisch. … Brot schmeckt gut.",
   "start": 221.747,
   "end": 224.575
  },
  {
   "block": 10,
   "role": "q",
   "k": 3,
   "text": "Drei: warm. Mit … Wasser.",
   "start": 225.475,
   "end": 228.182
  },
  {
   "block": 10,
   "role": "q",
   "k": 4,
   "text": "Vier: kalt. … Milch ist lecker.",
   "start": 229.082,
   "end": 231.786
  },
  {
   "block": 10,
   "role": "q",
   "k": 5,
   "text": "Fünf: nett. Viele … Leute.",
   "start": 232.686,
   "end": 235.697
  },
  {
   "block": 10,
   "role": "q",
   "k": 6,
   "text": "Sechs: schön. Bei … Wetter.",
   "start": 236.597,
   "end": 239.515
  },
  {
   "block": 10,
   "role": "pause",
   "k": 7,
   "text": "Drück auf Pause und denk nach!",
   "start": 240.415,
   "end": 242.586
  },
  {
   "block": 10,
   "role": "a",
   "k": 8,
   "text": "Ich trinke gern heißen Tee.",
   "start": 251.286,
   "end": 252.866
  },
  {
   "block": 10,
   "role": "a",
   "k": 9,
   "text": "Frisches Brot schmeckt gut.",
   "start": 253.766,
   "end": 255.554
  },
  {
   "block": 10,
   "role": "a",
   "k": 10,
   "text": "Mit warmem Wasser.",
   "start": 256.454,
   "end": 257.535
  },
  {
   "block": 10,
   "role": "a",
   "k": 11,
   "text": "Kalte Milch ist lecker.",
   "start": 258.435,
   "end": 259.77
  },
  {
   "block": 10,
   "role": "a",
   "k": 12,
   "text": "Viele nette Leute.",
   "start": 260.67,
   "end": 262.052
  },
  {
   "block": 10,
   "role": "a",
   "k": 13,
   "text": "Bei schönem Wetter.",
   "start": 262.952,
   "end": 264.006
  },
  {
   "block": 11,
   "role": "cta",
   "k": 0,
   "text": "Wie viele von zwölf hast du richtig? Schreib es in die Kommentare!",
   "start": 266.006,
   "end": 269.7
  }
 ]
}